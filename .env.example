APP_NAME=Quizora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Asia/Karachi
APP_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
# Leave DB_DATABASE unset for SQLite: the app uses database/database.sqlite.
# MySQL: DB_HOST=127.0.0.1, DB_PORT=3306, DB_DATABASE=quizora
# PostgreSQL: DB_HOST=127.0.0.1, DB_PORT=5432, DB_DATABASE=quizora
# Set DB_USERNAME and DB_PASSWORD when using a server database.
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
